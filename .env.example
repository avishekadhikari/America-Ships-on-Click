# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# DATABASE_URL: PostgreSQL connection string. When set, the app talks to a real
# PostgreSQL server through a `pg` connection pool. When unset (development
# only), it falls back to the embedded PGlite engine at .data/pgdata.
# Required when NODE_ENV=production.
DATABASE_URL="postgresql://asoc:asoc@localhost:5432/asoc"

# DATABASE_SSL: disable | require | verify-full. Omit to auto-detect
# (TLS for remote hosts such as Supabase/Neon/RDS, plaintext for localhost).
# DATABASE_SSL="require"
# DATABASE_SSL_CA="/path/to/server-ca.pem"   # only for verify-full

# Connection pool tuning (optional)
# DATABASE_POOL_MAX="10"
# DATABASE_IDLE_TIMEOUT_MS="30000"
# DATABASE_CONNECT_TIMEOUT_MS="10000"

# MIGRATIONS_DIR: override where *.sql migrations are read from (optional)
# MIGRATIONS_DIR="./src/db/migrations"

# DB_SEED: true | false. Demo data is seeded into an empty database in
# development. Set to "true" to also seed in production, "false" to never seed.
# DB_SEED="false"
# DEMO_PASSWORD="password123"

# ---------------------------------------------------------------------------
# APP
# ---------------------------------------------------------------------------
# Secret key for signing JWT tokens
JWT_SECRET="americashipsonclick_secret_jwt_key_2026"

# API base URL used by the frontend client (defaults to /api)
VITE_API_BASE_URL="/api"

# HTTP port for the server (defaults to 3000)
# PORT="3000"

# ---------------------------------------------------------------------------
# SECURITY
# ---------------------------------------------------------------------------
# DATABASE_ADMIN_URL: owner connection used for migrations and seeding only.
# DATABASE_URL should point at the least-privilege runtime role (asoc_app),
# which cannot run DDL or delete rows. Omit to use one role for both.
DATABASE_ADMIN_URL="postgresql://asoc:password@localhost:5433/asoc"

# ADMIN_PASSWORD: the passcode the platform administrator signs in with.
#
# Public signup cannot create an administrator — the role is refused by the
# API and by the users_insert policy (migration 0012) — so this is how the
# account gets a credential. On every start the account named by ADMIN_EMAIL
# is created with this password, or has its password brought in line with it;
# a rotation revokes the old sessions. Leave unset and nothing is managed:
# development keeps the demo account (admin@americashipsonclick.com /
# DEMO_PASSWORD), which is fine locally and must not be relied on in
# production. Must be at least 8 characters, and the server refuses to boot if
# it is set to the published demo password.
#
# Sign in at /admin with ADMIN_EMAIL and this value.
# ADMIN_EMAIL="admin@americashipsonclick.com"
# ADMIN_PASSWORD="change_me_to_a_long_random_value"

# HMAC key used to tokenize bank details. Rotating it invalidates existing
# payment tokens. Falls back to JWT_SECRET when unset.
PAYMENT_TOKEN_SECRET="change_me_to_a_long_random_value"

# TRUST_PROXY: set to "true" only when running behind a proxy you control, so
# X-Forwarded-For can be trusted for login throttling.
# TRUST_PROXY="false"
